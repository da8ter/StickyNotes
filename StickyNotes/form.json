{
    "elements": [
        {
            "type": "CheckBox",
            "name": "Overlay",
            "caption": "Show notes on top of the visualization"
        },
        {
            "type": "Select",
            "name": "Corner",
            "caption": "Corner of the note pad",
            "options": [
                {
                    "caption": "Top left",
                    "value": 0
                },
                {
                    "caption": "Top right",
                    "value": 1
                },
                {
                    "caption": "Bottom left",
                    "value": 2
                },
                {
                    "caption": "Bottom right",
                    "value": 3
                }
            ]
        },
        {
            "type": "NumberSpinner",
            "name": "PollSeconds",
            "caption": "Check for changes every",
            "suffix": "s",
            "minimum": 1,
            "maximum": 60
        },
        {
            "type": "Label",
            "caption": "Images from media objects can be placed on the board as stickers. Set them up here; they then appear as a choice at the plus button. Supported: PNG, JPEG, GIF, WebP and BMP up to 900 kB."
        },
        {
            "type": "List",
            "name": "Stickers",
            "caption": "Stickers",
            "rowCount": 5,
            "add": true,
            "delete": true,
            "changeOrder": true,
            "columns": [
                {
                    "caption": "Image",
                    "name": "Media",
                    "width": "auto",
                    "add": 0,
                    "save": true,
                    "edit": {
                        "type": "SelectMedia"
                    }
                },
                {
                    "caption": "Name",
                    "name": "Name",
                    "width": "260px",
                    "add": "",
                    "save": true,
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Label",
            "caption": "The browser extension \"Visu-Erweiterung für Symcon\" (Chrome, Edge) shows the notes right away on every page of the visualization. To use it, connect the extension with the address below, with your server address in front."
        },
        {
            "type": "Label",
            "caption": "Without the extension, the tile brings the notes into the visualization: they only appear once the page with the tile has been opened, and after every reload of the visualization only once it has been opened again. In the Symcon app the notes stay in the tile as a board and cannot be moved freely."
        }
    ]
}
